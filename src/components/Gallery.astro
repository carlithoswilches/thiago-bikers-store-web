---
import { site } from "@/data/site";
import { unsplash } from "@/data/types";

const { gallery } = site;
// Tamaños alternos para un carrusel editorial, no una cuadrícula uniforme
const sizes = [
  "w-[78vw] sm:w-[26rem] h-[24rem] sm:h-[30rem]",
  "w-[64vw] sm:w-[19rem] h-[20rem] sm:h-[23rem]",
  "w-[78vw] sm:w-[24rem] h-[24rem] sm:h-[34rem]",
  "w-[64vw] sm:w-[19rem] h-[20rem] sm:h-[26rem]",
  "w-[78vw] sm:w-[26rem] h-[24rem] sm:h-[30rem]",
];
---

<section id="galeria" class="py-24 md:py-32">
  <div class="mx-auto flex max-w-7xl flex-col gap-6 px-5 md:flex-row md:items-end md:justify-between">
    <div>
      <p class="eyebrow" data-reveal>{gallery.eyebrow}</p>
      <h2 class="mt-5 max-w-2xl font-display text-4xl leading-[1.04] tracking-tight md:text-6xl" data-reveal style="--d:80ms">
        {gallery.title}
      </h2>
    </div>
    <p class="text-sm text-muted" data-reveal>Desliza para ver más →</p>
  </div>

  <div
    class="no-scrollbar mt-12 flex snap-x snap-mandatory items-end gap-5 overflow-x-auto px-5 pb-4 lg:pl-[max(1.25rem,calc((100vw_-_80rem)/2_+_1.25rem))]"
  >
    {
      gallery.images.map((photo, i) => (
        <figure class:list={["group relative shrink-0 snap-start overflow-hidden rounded-[2rem]", sizes[i % sizes.length]]}>
          <img
            src={unsplash(photo.id, 900)}
            alt={photo.alt}
            loading="lazy"
            class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
          />
          <figcaption class="absolute bottom-4 left-4 rounded-full bg-bg/85 px-3 py-1 text-xs font-medium text-fg opacity-0 backdrop-blur transition group-hover:opacity-100">
            {photo.alt}
          </figcaption>
        </figure>
      ))
    }
    <div class="w-1 shrink-0"></div>
  </div>
</section>
