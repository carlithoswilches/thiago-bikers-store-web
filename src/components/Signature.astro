---
import { Icon } from "astro-icon/components";
import { site } from "@/data/site";
import { unsplash } from "@/data/types";

const { signature } = site;
---

<section id="nosotros" class="relative overflow-hidden bg-surface py-24 md:py-32">
  <div class="mx-auto max-w-7xl px-5">
    <div class="relative grid items-center gap-10 lg:grid-cols-12">
      <!-- Imagen grande que sangra a la izquierda -->
      <figure
        class="relative h-[24rem] overflow-hidden rounded-[2.5rem] sm:h-[32rem] lg:col-span-7 lg:col-start-1 lg:row-start-1 lg:-ml-[max(1.25rem,calc((100vw_-_80rem)/2_+_1.25rem))] lg:h-[40rem] lg:rounded-l-none"
        data-reveal
      >
        <img src={unsplash(signature.image.id, 1400)} alt={signature.image.alt} loading="lazy" class="h-full w-full object-cover" />
      </figure>

      <!-- Tarjeta superpuesta -->
      <div
        class="relative rounded-[2rem] bg-bg p-8 shadow-[0_40px_80px_-40px_rgba(0,0,0,0.35)] sm:p-12 lg:col-span-6 lg:col-start-7 lg:row-start-1 lg:-ml-10"
        data-reveal
        style="--d:120ms"
      >
        <p class="eyebrow">{signature.eyebrow}</p>
        <h2 class="mt-5 font-display text-4xl leading-[1.04] tracking-tight md:text-5xl">{signature.title}</h2>
        <p class="mt-6 text-lg text-muted">{signature.text}</p>

        <ul class="mt-8 space-y-3">
          {
            signature.points.map((point) => (
              <li class="flex gap-3">
                <Icon name="bx:check-circle" class="mt-0.5 h-5 w-5 shrink-0 text-primary" />
                <span>{point}</span>
              </li>
            ))
          }
        </ul>

        <div class="mt-9 flex flex-wrap gap-2">
          {
            signature.tags.map((tag, i) => (
              <span
                class:list={[
                  "rounded-full px-4 py-2 text-sm font-medium",
                  i === 0 ? "bg-primary text-primary-fg" : "border border-line bg-surface text-fg",
                ]}
              >
                {tag}
              </span>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
